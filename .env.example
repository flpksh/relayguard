APP_NAME=RelayGuard
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
HOST_PORT=8010
COMPOSE_PROJECT_NAME=relayguard
DATABASE_URL=postgresql+asyncpg://relayguard:relayguard@db:5432/relayguard
POSTGRES_DB=relayguard
POSTGRES_USER=relayguard
POSTGRES_PASSWORD=relayguard
ACCESS_TOKEN_SECRET=development-only-token-secret-change-me
# ACCESS_TOKEN_PREVIOUS_SECRET=preencha-durante-uma-rotacao-de-chave
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_ISSUER=relayguard
ACCESS_TOKEN_AUDIENCE=relayguard-api
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
API_CPUS=1.0
API_MEMORY=512m
DB_CPUS=1.0
DB_MEMORY=512m
